{
  "name": "viipers",
  "version": "0.3.0",
  "description": "Cloudflare Workers MCP server for autonomous stock trading with Alpaca",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy --config wrangler.deploy.json",
    "deploy:production": "bun run deploy",
    "db:migrate": "wrangler d1 migrations apply viipers-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.json",
    "db:studio": "wrangler d1 execute viipers-db --local --command 'SELECT 1'",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "setup:access": "bun scripts/setup-access.ts",
    "audit:unused": "bun scripts/audit-unused.mjs",
    "audit:security": "bun audit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/deepseek": "^3.0.61",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/xai": "^5.0.17",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/sdk": "~1.32.1",
    "agents": "^0.26.0",
    "ai": "^7.0.130",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
