{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "viipers",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENVIRONMENT": "production",
		"FEATURE_LLM_RESEARCH": "true",
		"FEATURE_OPTIONS": "true",
		"DEFAULT_MAX_POSITION_PCT": "0.10",
		"DEFAULT_MAX_NOTIONAL_PER_TRADE": "5000",
		"DEFAULT_MAX_DAILY_LOSS_PCT": "0.02",
		"DEFAULT_COOLDOWN_MINUTES": "30",
		"DEFAULT_MAX_OPEN_POSITIONS": "10",
		"DEFAULT_APPROVAL_TTL_SECONDS": "300",
		// "true" = anyone can view status, P&L, trades and activity read-only at /
		// (config and controls still require VIIPERS_API_TOKEN)
		"PUBLIC_DASHBOARD": "false"
	},
	// Secrets (set via `wrangler secret put <NAME>`):
	// Required:
	// - ALPACA_API_KEY
	// - ALPACA_API_SECRET
	// - VIIPERS_API_TOKEN (API authentication - generate with: openssl rand -base64 48)
	// - KILL_SWITCH_SECRET (emergency kill switch + approval token signing)
	//
	// Broker (default: alpaca). To trade crypto spot on OKX set var BROKER_PROVIDER=okx and:
	// - OKX_API_KEY, OKX_API_SECRET, OKX_API_PASSPHRASE
	//     Use a dedicated sub-account key with Read + Trade only (never Withdraw),
	//     leave the IP whitelist empty (Workers have no fixed egress IP), and start with OKX_SIMULATED=true.
	// - OKX_SIMULATED ("true" routes all requests to OKX demo trading; needs a demo-trading key)
	// - OKX_QUOTE_CCY (optional var: USDT default; use USDC for EEA/US accounts that hold no USDT)
	// - OKX_API_BASE_URL (optional, https only):
	//     default https://openapi.okx.com | EEA (my.okx.com) https://eea.okx.com | US/AU (app.okx.com) https://us.okx.com
	//
	// LLM Provider (choose one mode):
	// - LLM_PROVIDER ("openai-raw" | "ai-sdk" | "vercel-gateway", default: "openai-raw")
	// - LLM_MODEL (model identifier, e.g. "gpt-6-luna" or "anthropic/claude-opus-5-5"; list in src/providers/llm/models.ts)
	//
	// Provider API Keys (based on LLM_PROVIDER mode):
	// - OPENAI_API_KEY (for openai-raw, or ai-sdk with OpenAI models)
	// - OPENAI_BASE_URL (optional override for OpenAI-compatible proxy; affects openai-raw and ai-sdk OpenAI models)
	// - ANTHROPIC_API_KEY (for ai-sdk with Anthropic models)
	// - GOOGLE_GENERATIVE_AI_API_KEY (for ai-sdk with Google models)
	// - XAI_API_KEY (for ai-sdk with xAI/Grok models)
	// - DEEPSEEK_API_KEY (for ai-sdk with DeepSeek models)
	// - AI_GATEWAY_API_KEY (for vercel-gateway unified access)
	//
	// Optional:
	// - ALPACA_PAPER ("true" for paper trading)
	// - TWITTER_BEARER_TOKEN
	// - DISCORD_WEBHOOK_URL
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "viipers-db",
			"database_id": "<YOUR_D1_DATABASE_ID>",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "<YOUR_KV_NAMESPACE_ID>"
		}
	],
	"r2_buckets": [
		{
			"binding": "ARTIFACTS",
			"bucket_name": "viipers-artifacts"
		}
	],
	// Per-IP limit for the public read-only API (/api/public/*)
	"ratelimits": [
		{ "name": "PUBLIC_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION",
				"class_name": "SessionDO"
			},
			{
				"name": "VIIPERS_HARNESS",
				"class_name": "ViipersHarness"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SessionDO",
				"ViipersMcpAgent",
				"ViipersHarness"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": ["ViipersMcpAgent"]
		}
	],
	"triggers": {
		"crons": [
			"*/5 13-20 * * 1-5",
			"0 14 * * 1-5",
			"30 21 * * 1-5",
			"0 5 * * *",
			"0 * * * *"
		]
	},
	"build": {
		"command": "npm run build"
	},
	"dev": {
		"port": 8787
	}
}
